# ─── Database ────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sports_injury_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sports_injury_db

# ─── JWT Security ─────────────────────────────────────────────
JWT_SECRET_KEY=your_super_secret_key_change_this_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── App ──────────────────────────────────────────────────────
APP_ENV=development

# ─── Groq AI ──────────────────────────────────────────────────
# Get a free API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ─── SMTP Email (Gmail App Password) ──────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=SportGuard Support
